# Copy this file to .env and fill in your key.
# Server-side key used by the Vercel serverless functions (api/*.js).
GEMINI_API_KEY=your_gemini_api_key

# Optional model override (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Dev-only fallback: used by `npm run dev` when /api serverless functions are not running.
VITE_GEMINI_API_KEY=your_gemini_api_key
